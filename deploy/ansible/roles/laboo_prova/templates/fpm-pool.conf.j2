; Gerenciado pelo Ansible (deploy/ansible).
[laboo-live]
user = laboo-web
group = laboo-web
listen = /run/php/laboo-live.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = {{ laboo_fpm_max_children }}
pm.process_idle_timeout = 30s
pm.max_requests = 500
clear_env = yes
request_terminate_timeout = 45s
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_flag[session.upload_progress.enabled] = off
php_admin_flag[fatal_error_backtraces] = off
php_admin_value[upload_max_filesize] = 8M
php_admin_value[post_max_size] = 10M
php_admin_value[memory_limit] = {{ laboo_fpm_memory_limit }}
